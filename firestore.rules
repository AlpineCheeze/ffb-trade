rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Players Collection
    match /players/{playerId} {
      allow read: if true;
      // Allow updating ELO and votes_count
      allow update: if isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['elo', 'votes_count']) &&
        incoming().elo is number &&
        (incoming().votes_count == existing().votes_count + 1 || incoming().votes_count == existing().votes_count - 1);
      
      // Admin could create/delete, but for now we'll seed manually or allow first create
      allow create: if isSignedIn(); 
    }

    // Trades Collection
    match /trades/{tradeId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        isValidId(tradeId) &&
        incoming().give_player_ids is list &&
        incoming().get_player_ids is list &&
        incoming().give_player_ids.size() > 0 &&
        incoming().get_player_ids.size() > 0;
    }

    // Votes Collection
    match /votes/{voteId} {
      allow read: if isOwner(existing().user_id);
      allow create: if isOwner(incoming().user_id) &&
        incoming().choice in ['YES', 'NO'];
      allow delete: if isOwner(existing().user_id);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Matches Collection
    match /matches/{matchId} {
      allow read: if isSignedIn() && (isOwner(resource.data.user_a_id) || isOwner(resource.data.user_b_id));
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(resource.data.user_a_id) || isOwner(resource.data.user_b_id));
    }

    // Leagues Collection
    match /leagues/{leagueId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && 
        incoming().creator_id == request.auth.uid &&
        incoming().members.size() == 1 &&
        incoming().members[0] == request.auth.uid;
      allow update: if isSignedIn() && (
        // Allow joining
        (incoming().diff(existing()).affectedKeys().hasOnly(['members']) &&
         incoming().members.hasAll(existing().members) &&
         incoming().members.size() == existing().members.size() + 1 &&
         incoming().members[existing().members.size()] == request.auth.uid)
      );

      match /player_stats/{playerId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members);
        allow write: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.members);
      }
    }
  }
}
